#%Module1.0
##
## modules ufo/1.0
##

module-whatis    "Name: UFO-Tofu"
module-whatis    "Version: 1.0"
module-whatis    "Category: GLib-GObject OpenCL Python packages"
module-whatis    "Description: UFO-Tofu data processing framework for Tomography and Laminography"
module-whatis    "URL: https://github.com/ufo-kit"

# Help text for module
proc ModulesHelp { } {
    puts stderr "ufo/1.0 - sets the Environment for UFO-Tofu data processing framework for Tomography and Laminography"
}

# Define installation root [CHANGE]
setenv UFO_ROOT /home/ws/nj4412/workspace/ufo_install/apps

# Test for installation root
proc ModulesTest { } {
    set retcode 1  ;# default: 1 meaning PASS

    puts stderr "Running ModulesTest for directory existence..."
    if { [file isdirectory [getenv UFO_ROOT]] } {
        puts stderr "Is a directory: [getenv UFO_ROOT]"
    } else {
        puts stderr "ERROR: Is not a directory: [getenv UFO_ROOT]"
        set retcode 0
    }
    puts stderr "Running ModulesTest for directory existence...done"

    puts stderr "Running ModulesTest for directory permissions..."
    set cmd { cd [getenv UFO_ROOT] }
    if { [catch $cmd errmsg] } {
        puts stderr "ERROR: Was not able to enter directory [getenv UFO_ROOT]: ${errmsg}"
        set retcode 0
    } else {
        puts stderr "Was able to enter directory [getenv UFO_ROOT]"
    }
    puts stderr "Running ModulesTest for directory permissions...done"

    return $retcode
}

prepend-path PATH         [getenv UFO_ROOT]/bin
# Specific to Ubuntu 24.04 (For RHEL 9 it should not be required)
prepend-path PATH		[getenv UFO_ROOT]/local/bin
# tofu
# Specific tp Ubuntu 24.04 (For RHEL 9 it should be site-packages like below)
prepend-path PYTHONPATH        [getenv UFO_ROOT]/local/lib/python3.12/dist-packages
# ufo-core/python
#prepend-path PYTHONPATH        [getenv UFO_ROOT]/lib/python3.9/site-packages
prepend-path XDG_DATA_DIRS    [getenv UFO_ROOT]/share

# Compilation and Linking
prepend-path PKG_CONFIG_PATH     [getenv UFO_ROOT]/lib/pkgconfig

# GObject Introspection
prepend-path GI_TYPELIB_PATH     [getenv UFO_ROOT]/lib/girepository-1.0

# Shared Libraries
prepend-path LD_LIBRARY_PATH     [getenv UFO_ROOT]/lib

